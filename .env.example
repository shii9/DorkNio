# DorkNio - Client Environment Variables Template
# Copy this file to '.env' or '.env.local' and add your credentials.
# IMPORTANT NOTE: In Vite, any variable prefixed with 'VITE_' will be exposed to the client bundle.
# Do NOT prefix private database passwords or internal server keys with VITE_ if they should not be accessible in the browser.

# --- Search APIs & Engines (Optional) ---
# Google Custom Search Engine ID & API Key
VITE_GOOGLE_CX=
VITE_GOOGLE_API_KEY=

# --- SEO & Site Audit Integrations (Optional) ---
# Google PageSpeed Insights API Key (for Lab / CrUX field metrics)
VITE_PAGESPEED_API_KEY=your_google_api_key_here

# Firecrawl API Key (for full website scraping & mapping)
VITE_FIRECRAWL_API_KEY=fc-your_firecrawl_key_here

# Semrush / Moz / Ahrefs Keys
VITE_SEMRUSH_API_KEY=
VITE_MOZ_API_KEY=
